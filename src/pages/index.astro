<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Project sliders
    const sliders = document.querySelectorAll('[data-slider]');
    
    sliders.forEach((slider) => {
      const idx = slider.getAttribute('data-slider');
      const track = slider.querySelector('.slider-track') as HTMLElement;
      const images = track?.querySelectorAll('img');
      const prevBtn = document.querySelector(`[data-slider-prev="${idx}"]`);
      const nextBtn = document.querySelector(`[data-slider-next="${idx}"]`);
      const dots = document.querySelectorAll(`[data-dot^="${idx}-"]`);
      
      if (!track || !images || images.length === 0) return;
      
      let current = 0;
      const total = images.length;
      
      const updateSlider = () => {
        track.style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((dot, i) => {
          dot.classList.toggle('bg-accent', i === current);
          dot.classList.toggle('bg-white/30', i !== current);
        });
      };
      
      prevBtn?.addEventListener('click', () => {
        current = (current - 1 + total) % total;
        updateSlider();
      });
      
      nextBtn?.addEventListener('click', () => {
        current = (current + 1) % total;
        updateSlider();
      });
    });
    
    // Exploration sliders
    const expSliders = document.querySelectorAll('[data-exp-slider]');
    
    expSliders.forEach((slider) => {
      const track = slider.querySelector('.exp-slider-track') as HTMLElement;
      const images = track?.querySelectorAll('img');
      const prevBtn = slider.querySelector('.exp-prev');
      const nextBtn = slider.querySelector('.exp-next');
      const dots = slider.querySelectorAll('.exp-dot');
      
      if (!track || !images || images.length === 0) return;
      
      let current = 0;
      const total = images.length;
      
      const updateSlider = () => {
        track.style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((dot, i) => {
          dot.classList.toggle('bg-accent', i === current);
          dot.classList.toggle('bg-white/30', i !== current);
        });
      };
      
      prevBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        current = (current - 1 + total) % total;
        updateSlider();
      });
      
      nextBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        current = (current + 1) % total;
        updateSlider();
      });
    });
  });
</script>
