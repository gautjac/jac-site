---
import Layout from '../layouts/Layout.astro';
import content from '../content/en.json';
---

<Layout title="Jac Gautreau — Words, Music, Ideas" lang="en">
  <!-- Navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 nav-bg backdrop-blur-sm border-b border-themed">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <a href="/" class="text-xl font-bold tracking-tight text-text-primary hover:text-accent transition-colors">JG<span class="text-accent">.</span></a>
      <div class="flex items-center gap-3 md:gap-8">
        <div class="hidden md:flex gap-6 text-sm">
          <a href="#about" class="text-text-secondary hover:text-accent transition-colors">{content.nav.about}</a>
          <a href="#work" class="text-text-secondary hover:text-accent transition-colors">{content.nav.work}</a>
          <a href="#projects" class="text-text-secondary hover:text-accent transition-colors">{content.nav.projects}</a>
          <a href="#explorations" class="text-text-secondary hover:text-accent transition-colors">Explorations</a>
          <a href="/writing" class="text-text-secondary hover:text-accent transition-colors">{content.nav.writing}</a>
          <a href="/poems" class="text-text-secondary hover:text-accent transition-colors">Poems</a>
          <a href="#contact" class="text-text-secondary hover:text-accent transition-colors">{content.nav.contact}</a>
        </div>
        <a href="/resume" class="hidden md:inline-block px-3 py-1 bg-accent/10 border border-accent/30 rounded text-sm text-accent hover:bg-accent hover:text-dark transition-colors">
          Resume
        </a>
        <a href={content.otherLangUrl} class="hidden md:inline-block px-3 py-1 border border-themed-strong rounded text-sm text-text-secondary hover:border-accent hover:text-accent transition-colors">
          {content.otherLangLabel}
        </a>
        <!-- Mobile: lang switcher + hamburger -->
        <a href={content.otherLangUrl} class="md:hidden px-2 py-1 border border-themed-strong rounded text-xs text-text-secondary">
          {content.otherLangLabel}
        </a>
        <button id="mobile-menu-btn" class="md:hidden flex flex-col gap-1.5 p-1" aria-label="Menu">
          <span class="block w-5 h-0.5 bg-text-primary transition-all"></span>
          <span class="block w-5 h-0.5 bg-text-primary transition-all"></span>
          <span class="block w-5 h-0.5 bg-text-primary transition-all"></span>
        </button>
      </div>
    </div>
    <!-- Mobile menu drawer -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-themed px-6 py-4 space-y-4 nav-bg">
      <a href="#about" class="block text-sm text-text-secondary hover:text-accent transition-colors mobile-nav-link">{content.nav.about}</a>
      <a href="#work" class="block text-sm text-text-secondary hover:text-accent transition-colors mobile-nav-link">{content.nav.work}</a>
      <a href="#projects" class="block text-sm text-text-secondary hover:text-accent transition-colors mobile-nav-link">{content.nav.projects}</a>
      <a href="#explorations" class="block text-sm text-text-secondary hover:text-accent transition-colors mobile-nav-link">Explorations</a>
      <a href="/writing" class="block text-sm text-text-secondary hover:text-accent transition-colors">{content.nav.writing}</a>
      <a href="#contact" class="block text-sm text-text-secondary hover:text-accent transition-colors mobile-nav-link">{content.nav.contact}</a>
      <a href="/resume" class="inline-block px-3 py-1 bg-accent/10 border border-accent/30 rounded text-sm text-accent">Resume</a>
    </div>
  </nav>

  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
    // Close on nav link click
    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => menu?.classList.add('hidden'));
    });
  </script>

  <!-- Hero Section -->
  <section class="min-h-screen flex items-center pt-20 px-6">
    <div class="max-w-7xl mx-auto w-full grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: Text Content -->
      <div class="text-center lg:text-left order-2 lg:order-1">
        <p class="text-accent text-sm tracking-[0.3em] uppercase mb-6 animate-fade-slide-up">
          {content.hero.tagline.join(' / ')}
        </p>
        <h1 class="text-6xl md:text-7xl lg:text-8xl xl:text-9xl font-black tracking-tight leading-[0.9] mb-6">
          <span class="block animate-fade-slide-up delay-200 text-inherit">{content.hero.name.split(' ')[0]}</span>
          <span class="block animate-fade-slide-up delay-400">
            <span class="text-accent">{content.hero.name.split(' ')[1]}</span><span class="text-accent">.</span>
          </span>
        </h1>
        <p class="text-xl md:text-2xl text-gray-400 tracking-wide mb-8 animate-fade-slide-up delay-500">
          {content.hero.subtitle}
        </p>
        <div class="flex justify-center lg:justify-start gap-4 animate-fade-slide-up delay-600">
          <a href="#work" class="px-8 py-3 bg-accent text-dark font-semibold rounded hover:bg-white transition-colors">
            {content.nav.work}
          </a>
          <a href="#contact" class="px-8 py-3 border border-white/20 rounded hover:border-accent hover:text-accent transition-colors">
            {content.nav.contact}
          </a>
        </div>
      </div>
      <!-- Right: Portrait Grid -->
      <div class="order-1 lg:order-2 flex justify-center lg:justify-end">
        <div class="relative animate-scale-in delay-300">
          <img 
            src="/images/jac-portrait-grid.jpg" 
            alt="Jac Gautreau - Portrait Series" 
            class="w-full max-w-md lg:max-w-lg xl:max-w-xl rounded-lg shadow-2xl"
          />
          <div class="absolute -inset-4 border border-accent/20 rounded-lg -z-10"></div>
          <div class="absolute -inset-8 border border-accent/10 rounded-lg -z-20"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="py-32 px-6">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-center">
      <div class="reveal reveal-left">
        <h2 class="text-5xl md:text-6xl font-black mb-8">
          {content.about.title}<span class="text-accent glow-accent">.</span>
        </h2>
        <div class="space-y-6 text-lg text-gray-300 leading-relaxed">
          {content.about.content.map((paragraph: string) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
      <div class="relative reveal reveal-right">
        <img 
          src="/images/jac-headshot.jpg" 
          alt="Jac Gautreau" 
          class="w-full rounded-lg shadow-2xl hover:shadow-accent/20 transition-shadow duration-500"
        />
        <div class="absolute -inset-4 border border-accent/20 rounded-lg -z-10"></div>
      </div>
    </div>
  </section>

  <!-- What I Do Section -->
  <section id="work" class="py-32 px-6 bg-darker">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-5xl md:text-6xl font-black mb-16 reveal">
        {content.work.title}<span class="text-accent glow-accent">.</span>
      </h2>
      <div class="space-y-8 stagger-children reveal">
        {content.work.items.map((item: { number: string; title: string; description: string }, idx: number) => (
          <div class="stagger-item group grid md:grid-cols-12 gap-6 py-8 border-b border-white/10 hover:border-accent/50 transition-all duration-300 hover:pl-2">
            <div class="md:col-span-1 flex items-start">
              <span class="text-accent w-6 h-6 group-hover:scale-110 transition-transform">
                {idx === 0 && (
                  <!-- Compass / Direction -->
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="currentColor" stroke="none"/>
                  </svg>
                )}
                {idx === 1 && (
                  <!-- Music Note -->
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18V5l12-2v13"/>
                    <circle cx="6" cy="18" r="3"/>
                    <circle cx="18" cy="16" r="3"/>
                  </svg>
                )}
                {idx === 2 && (
                  <!-- Feather / Pen -->
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/>
                    <line x1="16" y1="8" x2="2" y2="22"/>
                    <line x1="17.5" y1="15" x2="9" y2="15"/>
                  </svg>
                )}
                {idx === 3 && (
                  <!-- Code Brackets -->
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 18 22 12 16 6"/>
                    <polyline points="8 6 2 12 8 18"/>
                  </svg>
                )}
                {idx === 4 && (
                  <!-- Sparkles / AI -->
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3v1m0 16v1m-9-9h1m16 0h1m-2.64-6.36l-.7.7m-12.02 12.02l-.7.7m0-12.72l.7.7m12.02 12.02l.7.7"/>
                    <circle cx="12" cy="12" r="4"/>
                  </svg>
                )}
              </span>
            </div>
            <div class="md:col-span-4">
              <h3 class="text-2xl font-bold group-hover:text-accent transition-colors">{item.title}</h3>
            </div>
            <div class="md:col-span-7">
              <p class="text-gray-400 leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="py-32 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-5xl md:text-6xl font-black mb-16 reveal">
        {content.projects.title}<span class="text-accent glow-accent">.</span>
      </h2>
      <div class="grid md:grid-cols-2 gap-8 stagger-children reveal">
        {content.projects.items.map((project: { title: string; description: string; category: string; image?: string; images?: string[] }, idx: number) => (
          <div class="stagger-item group relative bg-darker rounded-lg overflow-hidden hover:ring-2 hover:ring-accent/50 transition-all duration-300 hover-lift">
            {project.images && project.images.length > 1 ? (
              <div class="relative aspect-video overflow-hidden" data-slider={idx}>
                <div class="slider-track flex transition-transform duration-500 ease-out" style="width: 100%;">
                  {project.images.map((img: string, i: number) => (
                    <img src={img} alt={`${project.title} ${i + 1}`} class="aspect-video object-cover w-full flex-shrink-0" />
                  ))}
                </div>
                <button class="slider-prev absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 bg-black/50 rounded-full flex items-center justify-center hover:bg-accent transition-colors" data-slider-prev={idx}>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                </button>
                <button class="slider-next absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 bg-black/50 rounded-full flex items-center justify-center hover:bg-accent transition-colors" data-slider-next={idx}>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>
                <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1">
                  {project.images.map((_: string, i: number) => (
                    <span class={`w-2 h-2 rounded-full ${i === 0 ? 'bg-accent' : 'bg-white/30'}`} data-dot={`${idx}-${i}`}></span>
                  ))}
                </div>
              </div>
            ) : project.images && project.images.length === 1 ? (
              <img src={project.images[0]} alt={project.title} class="aspect-video object-cover w-full" />
            ) : project.image ? (
              <img src={project.image} alt={project.title} class="aspect-video object-cover w-full" />
            ) : (
              <div class="aspect-video bg-gradient-to-br from-white/5 to-transparent"></div>
            )}
            <div class="p-6">
              <span class="text-accent text-xs tracking-wider uppercase">{project.category}</span>
              <h3 class="text-2xl font-bold mt-2 group-hover:text-accent transition-colors">{project.title}</h3>
              <p class="text-gray-400 mt-2">{project.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Digital Explorations Section -->
  <section id="explorations" class="py-32 px-6 bg-darker">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-5xl md:text-6xl font-black mb-4 reveal">
        {content.explorations.title}<span class="text-accent glow-accent">.</span>
      </h2>
      <p class="text-xl text-gray-400 mb-16 reveal">{content.explorations.subtitle}</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 stagger-children reveal">
        {content.explorations.items.map((item: { title: string; description: string; category: string; url?: string; images?: string[] }) => (
          <div class="stagger-item group relative bg-dark rounded-lg overflow-hidden hover:ring-2 hover:ring-accent/50 transition-all duration-300 hover-lift">
            {item.images && item.images.length > 1 ? (
              <div class="relative aspect-[4/3] overflow-hidden" data-exp-slider>
                <div class="exp-slider-track flex transition-transform duration-500 ease-out" style="width: 100%;">
                  {item.images.map((img: string, i: number) => (
                    <img src={img} alt={`${item.title} ${i + 1}`} class="aspect-[4/3] object-cover object-top w-full flex-shrink-0" />
                  ))}
                </div>
                <button class="exp-prev absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 bg-black/50 rounded-full flex items-center justify-center hover:bg-accent transition-colors opacity-0 group-hover:opacity-100">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                </button>
                <button class="exp-next absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 bg-black/50 rounded-full flex items-center justify-center hover:bg-accent transition-colors opacity-0 group-hover:opacity-100">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>
                <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1">
                  {item.images.map((_: string, i: number) => (
                    <span class={`exp-dot w-2 h-2 rounded-full transition-colors ${i === 0 ? 'bg-accent' : 'bg-white/30'}`}></span>
                  ))}
                </div>
              </div>
            ) : item.images && item.images.length === 1 ? (
              <img src={item.images[0]} alt={item.title} class="aspect-[4/3] object-cover object-top w-full" />
            ) : (
              <div class="aspect-[4/3] bg-gradient-to-br from-accent/10 to-transparent flex items-center justify-center">
                <svg class="w-16 h-16 text-accent/30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
            )}
            <div class="p-6">
              <span class="text-accent text-xs tracking-wider uppercase">{item.category}</span>
              <h3 class="text-xl font-bold mt-2 group-hover:text-accent transition-colors">{item.title}</h3>
              <p class="text-gray-400 mt-2 text-sm leading-relaxed">{item.description}</p>
              {item.url && (
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 mt-4 text-accent text-sm hover:underline">
                  View Live
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-32 px-6">
    <div class="max-w-4xl mx-auto text-center reveal">
      <h2 class="text-5xl md:text-6xl font-black mb-8">
        {content.contact.title}<span class="text-accent glow-accent">.</span>
      </h2>
      <p class="text-xl text-gray-300 mb-12">{content.contact.content}</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="mailto:jac@jacgautreau.com" class="inline-block px-12 py-4 bg-accent text-dark font-bold text-lg rounded hover:bg-white hover:scale-105 transition-all duration-300">
          {content.contact.email}
        </a>
        <button 
          onclick="Calendly.initPopupWidget({url: 'https://calendly.com/jac-jacgautreau/30min'});return false;"
          class="inline-block px-12 py-4 border-2 border-accent text-accent font-bold text-lg rounded hover:bg-accent hover:text-dark hover:scale-105 transition-all duration-300 cursor-pointer"
        >
          Book a Call
        </button>
      </div>
      <p class="mt-8 text-gray-500">{content.contact.location}</p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-8 px-6 border-t border-themed">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6 text-sm text-muted">
      <p>{content.footer.copyright}</p>
      <div class="flex items-center gap-4">
        <a href="https://x.com/gautjac" target="_blank" rel="noopener noreferrer" class="hover:text-accent hover:scale-110 transition-all duration-300" aria-label="X (Twitter)">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://linkedin.com/in/jac-gautreau-1767a7367" target="_blank" rel="noopener noreferrer" class="hover:text-accent hover:scale-110 transition-all duration-300" aria-label="LinkedIn">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="https://instagram.com/gautjac" target="_blank" rel="noopener noreferrer" class="hover:text-accent hover:scale-110 transition-all duration-300" aria-label="Instagram">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href="https://www.youtube.com/@jacgautreau" target="_blank" rel="noopener noreferrer" class="hover:text-accent hover:scale-110 transition-all duration-300" aria-label="YouTube">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </div>
      <p>{content.footer.madeWith}</p>
    </div>
  </footer>
</Layout>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .animate-fade-in {
    animation: fade-in 1s ease-out;
  }
  
  .slider-track {
    display: flex;
  }
  
  /* Theme-aware utilities */
  .nav-bg {
    background-color: var(--color-nav-bg);
  }
  
